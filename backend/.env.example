# Live UAT integration credentials (R13–R16). Copy to backend/.env and fill in.
# backend/.env is gitignored. Values are never committed and never logged.

# Odoo UAT — JSON-RPC
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=

# PEAK UAT — full-write invoice/QR (R15)
PEAK_UAT_CONNECT_ID=
PEAK_UAT_PASSWORD=
PEAK_UAT_USER_TOKEN=
# Optional: override the probed API base
# PEAK_UAT_BASE_URL=https://openapi.peakaccount.com

# PEAK invoice-report API — door 2 (Feedback Round 1 WP5). Unverified: setting both moves the door from not_configured to untested; nothing is pulled until an endpoint is verified against PEAK's documentation.
# PEAK_REPORT_API_BASE_URL=
# PEAK_REPORT_API_TOKEN=
