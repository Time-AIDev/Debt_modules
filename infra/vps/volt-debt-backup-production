#!/bin/bash
# volt-debt-backup-production — wrapper for production environment backup
# Called by volt-debt-backup-production.service
set -euo pipefail

export VOLT_ENV="${VOLT_ENV:-production}"
export COMPOSE_FILE="${COMPOSE_FILE:-/srv/volt-debt-platform/infra/vps/compose.production.yaml}"
export COMPOSE_ENV_FILE="${COMPOSE_ENV_FILE:-/srv/volt-debt-platform/.env.production}"
export DATA_DIR="${DATA_DIR:-/srv/volt-debt-data-production}"
export DB_SERVICE="${DB_SERVICE:-db-prd}"
export API_SERVICE="${API_SERVICE:-api-prd}"
export BACKUP_DIR="${BACKUP_DIR:-/var/backups/volt-debt-production}"
export QUIESCE_WRITERS="${QUIESCE_WRITERS:-1}"

# Create backup directory
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

# Run the shared backup script
exec /usr/local/lib/volt-debt-ops/backup.sh
