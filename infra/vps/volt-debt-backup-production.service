[Unit]
Description=Volt Debt PRODUCTION database and private object backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=VOLT_ENV=production
Environment=COMPOSE_FILE=/srv/volt-debt-platform/infra/vps/compose.production.yaml
Environment=COMPOSE_ENV_FILE=/srv/volt-debt-platform/.env.production
Environment=DATA_DIR=/srv/volt-debt-data-production
Environment=DB_SERVICE=db-prd
Environment=API_SERVICE=api-prd
Environment=QUIESCE_WRITERS=1
ExecStart=/usr/local/sbin/volt-debt-backup-production
TimeoutStartSec=45min
TimeoutStopSec=180s
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
