# ============================================================
# volt-debt-platform — STAGING environment template
# Copy to /srv/volt-debt-platform/.env.staging on the VPS.
# NEVER commit the real file.
# ============================================================

# ── Environment flag ─────────────────────────────────────────
# stg = staging (allows test accounts, relaxed auth)
# prd = production (strict validation, no test accounts)
ENV=stg

# ── Docker images ────────────────────────────────────────────
# CI updates these on deploy. Manual for initial setup.
API_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-api:staging
WEB_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-web:staging
SCANNER_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-scanner:staging
EDGE_IMAGE=caddy:2.8

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGING_PASSWORD
MIGRATION_DATABASE_URL=postgresql://debt_migrate:CHANGE_ME_STRONG_STAGING_PASSWORD@db-stg:5432/debt
DB_RUNTIME_ROLE=debt_api

# ── Compose project name (must match compose.staging.yaml) ──
COMPOSE_PROJECT_NAME=volt-debt-stg

# ── Optional overrides ───────────────────────────────────────
# POSTGRES_PORT=5432
# API_PORT=8081
# WEB_PORT=8080
