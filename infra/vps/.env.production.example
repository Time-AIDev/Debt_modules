# ============================================================
# volt-debt-platform — PRODUCTION environment template
# Copy to /srv/volt-debt-platform/.env.production on the VPS.
# NEVER commit the real file.
# ============================================================

# ── Environment flag ─────────────────────────────────────────
# prd = production (strict validation, no test accounts)
ENV=prd

# ── Docker images ────────────────────────────────────────────
# Use immutable version tags (vX.Y.Z) for production.
# CI builds these on tag push. Manual for initial setup.
API_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-api:v1.0.0
WEB_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-web:v1.0.0
SCANNER_IMAGE=ghcr.io/YOUR_GHCR_OWNER/volt-debt-scanner:v1.0.0
EDGE_IMAGE=caddy:2.8

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16
POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD
MIGRATION_DATABASE_URL=postgresql://debt_migrate:CHANGE_ME_DIFFERENT_STRONG_PASSWORD@db-prd:5432/debt
DB_RUNTIME_ROLE=debt_api

# ── Compose project name (must match compose.production.yaml) ─
COMPOSE_PROJECT_NAME=volt-debt-prd

# ── Optional overrides ───────────────────────────────────────
# POSTGRES_PORT=5433
# API_PORT=8082
# WEB_PORT=8083
