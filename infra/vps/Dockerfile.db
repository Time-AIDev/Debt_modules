# Rebuild gosu 1.19 from its exact upstream source with a patched Go toolchain.
# Runtime remains the official PostgreSQL 16 image and entrypoint.
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS gosu-builder
ARG GOSU_COMMIT=6456aaa0f3c854d199d0f037f068eb97515b7513
ARG GOSU_SOURCE_SHA256=33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b
ENV CGO_ENABLED=0 GOMAXPROCS=1 GOMEMLIMIT=128MiB
WORKDIR /src/gosu
RUN wget -O /tmp/gosu.tar.gz "https://codeload.github.com/tianon/gosu/tar.gz/${GOSU_COMMIT}" \
    && echo "${GOSU_SOURCE_SHA256}  /tmp/gosu.tar.gz" | sha256sum -c \
    && tar --extract --gzip --file /tmp/gosu.tar.gz --strip-components=1 \
    && go mod download \
    && go mod verify \
    && go build -trimpath -buildvcs=false -ldflags '-d -w' -o /out/gosu . \
    && /out/gosu --version \
    && /out/gosu nobody id \
    && go version -m /out/gosu

FROM postgres@sha256:65b16a8b326e0cfbdf33fa7e783f2a0cb352a61448616ccccfd616ef42aa0f65
USER root
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gosu-builder /out/gosu /usr/local/bin/gosu
RUN chmod 0755 /usr/local/bin/gosu \
    && test "$PG_MAJOR" = 16 \
    && gosu --version \
    && gosu postgres id \
    && postgres --version
LABEL volt-debt.upstream.postgres.digest="sha256:65b16a8b326e0cfbdf33fa7e783f2a0cb352a61448616ccccfd616ef42aa0f65" \
      volt-debt.gosu.version="1.19" \
      volt-debt.gosu.source_commit="6456aaa0f3c854d199d0f037f068eb97515b7513" \
      volt-debt.gosu.source_sha256="33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b" \
      volt-debt.gosu.go_version="go1.27.1"
