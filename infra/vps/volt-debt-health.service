[Unit]
Description=Volt Debt local production health checks
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/volt-debt-health
User=root
TimeoutStartSec=60
UMask=0077
StateDirectory=volt-debt-ops
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
