#!/bin/bash
# volt-debt-backup-staging — wrapper for staging environment backup
# Called by volt-debt-backup-staging.service
set -euo pipefail

export VOLT_ENV="${VOLT_ENV:-staging}"
export COMPOSE_FILE="${COMPOSE_FILE:-/srv/volt-debt-platform/infra/vps/compose.staging.yaml}"
export COMPOSE_ENV_FILE="${COMPOSE_ENV_FILE:-/srv/volt-debt-platform/.env.staging}"
export DATA_DIR="${DATA_DIR:-/srv/volt-debt-data-staging}"
export DB_SERVICE="${DB_SERVICE:-db-stg}"
export API_SERVICE="${API_SERVICE:-api-stg}"
export BACKUP_DIR="${BACKUP_DIR:-/var/backups/volt-debt-staging}"
export QUIESCE_WRITERS="${QUIESCE_WRITERS:-1}"

# Create backup directory
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

# Run the shared backup script
exec /usr/local/lib/volt-debt-ops/backup.sh
