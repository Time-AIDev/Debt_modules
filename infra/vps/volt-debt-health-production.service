[Unit]
Description=Volt Debt PRODUCTION local health checks
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/volt-debt-health-production
User=root
TimeoutStartSec=60
UMask=0077
Environment=VOLT_ENV=production
Environment=COMPOSE_FILE=/srv/volt-debt-platform/infra/vps/compose.production.yaml
Environment=COMPOSE_ENV_FILE=/srv/volt-debt-platform/.env.production
Environment=API_SERVICE=api-prd
Environment=WEB_SERVICE=web-prd
Environment=API_HEALTH_URL=http://127.0.0.1:8082/readyz
Environment=WEB_HEALTH_URL=http://127.0.0.1:8083/healthz
StateDirectory=volt-debt-ops-production
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
