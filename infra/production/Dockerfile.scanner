FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CLAMAV_HOST=127.0.0.1 CLAMAV_PORT=3310
RUN apt-get update && apt-get install -y --no-install-recommends clamav clamav-daemon clamav-freshclam && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY infra/production/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
COPY backend/app /srv/app
COPY infra/production/scanner-start.py /srv/scanner-start.py
RUN printf 'Foreground yes\nTCPSocket 3310\nTCPAddr 127.0.0.1\nDatabaseDirectory /var/lib/clamav\nStreamMaxLength 25M\nMaxFileSize 25M\nMaxScanSize 100M\nMaxThreads 1\nLogTime yes\n' > /srv/clamd.conf && chown -R clamav:clamav /srv /var/lib/clamav
USER clamav
CMD ["python", "/srv/scanner-start.py"]
